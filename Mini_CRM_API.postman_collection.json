							},
							{
								"key": "Accept",
								"value": "application/json",
								"type": "text"
							}
						],
						"url": {
							"raw": "{{base_url}}/api/leads/1",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"leads",
								"1"
							]
						},
						"description": "Soft delete a lead. Only admins can delete leads. The lead is marked as deleted but remains in the database."
					},
					"response": []

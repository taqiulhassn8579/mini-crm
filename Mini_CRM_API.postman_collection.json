								},
								{
									"key": "per_page",
									"value": "10",
									"description": "Number of leads per page"
								},
								{
									"key": "status",
									"value": "new",
									"description": "Filter by status (new, contacted, closed)"
								},
								{
									"key": "agent",
									"value": "",
									"description": "Filter by agent ID"
								},
								{
									"key": "search",
									"value": "",

	"event": [
		{
			"listen": "prerequest",
			"script": {
				"type": "text/javascript",
				"exec": [
					"// Auto-set Content-Type for POST/PUT requests",
					"if (pm.request.method === 'POST' || pm.request.method === 'PUT') {",
					"    pm.request.headers.add({",
					"        key: 'Content-Type',",
					"        value: 'application/json'",
					"    });",
					"}"
				]
			}
		},
		{
			"listen": "test",
			"script": {
				"type": "text/javascript",
				"exec": [
					"// Auto-save auth token from login response",
					"if (pm.response.code === 200 && pm.request.url.path.includes('login')) {",
					"    const response = pm.response.json();",
					"    if (response.token) {",
					"        pm.environment.set('auth_token', response.token);",
					"        console.log('Auth token saved:', response.token);",
					"    }",
					"    if (response.user) {",
					"        pm.environment.set('user_role', response.user.role);",
					"        pm.environment.set('user_name', response.user.name);",
					"        console.log('User info saved:', response.user.name, '(', response.user.role, ')');",
					"    }",
					"}",
					"",
					"// Log response status and time",
					"console.log('Response:', pm.response.code, pm.response.status, '(', pm.response.responseTime, 'ms)');",
					"",
					"// Validate response structure",
					"if (pm.response.code >= 200 && pm.response.code < 300) {",
					"    console.log('✅ Request successful');",
					"} else {",
					"    console.log('❌ Request failed');",
					"}"
				]
			}
		}
	],

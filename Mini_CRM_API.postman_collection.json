								},
								{
									"key": "sort_by",
									"value": "created_at",
									"description": "Sort by field (name, email, status, created_at, assigned_to)"
								},
								{
									"key": "sort_direction",
									"value": "desc",
									"description": "Sort direction (asc, desc)"
								}
							]
						},
						"description": "Retrieve all leads with filtering, search, and pagination. Admins see all leads, agents see only their assigned leads."
					},
					"response": []
				},
				{
					"name": "Create Lead",
